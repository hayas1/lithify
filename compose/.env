COMPOSE_PROFILES=bigquery-emulator,rustfs

CDC_MYSQL_TOPICS_REGEX='mysql(\.shop\..+)?'
CDC_POSTGRES_TOPICS_REGEX='postgres\.shop\..+'
CDC_MYSQL_NAMESPACE=mysql_shop
CDC_POSTGRES_NAMESPACE=postgres_shop
CDC_MYSQL_LOG_NAMESPACE=${CDC_MYSQL_NAMESPACE}_cdc
CDC_POSTGRES_LOG_NAMESPACE=${CDC_POSTGRES_NAMESPACE}_cdc

BIGQUERY_PROJECT=local-project
BIGQUERY_MYSQL_DATASET=${CDC_MYSQL_LOG_NAMESPACE}
BIGQUERY_POSTGRES_DATASET=${CDC_POSTGRES_LOG_NAMESPACE}
GCP_CREDENTIALS_FILE=./bigquery-proxy/application_default_credentials.json

S3_ENDPOINT=http://rustfs:9000
S3_REGION=us-east-1
S3_BUCKET=lithify
S3_MYSQL_PREFIX=${CDC_MYSQL_LOG_NAMESPACE}
S3_POSTGRES_PREFIX=${CDC_POSTGRES_LOG_NAMESPACE}
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
