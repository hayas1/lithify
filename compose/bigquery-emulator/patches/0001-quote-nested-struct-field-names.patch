@@ -0,0 +1,20 @@
+package server_test
+
+import (
+	"context"
+	"testing"
+
+	"cloud.google.com/go/bigquery"
+)
+
+func TestBigQueryCompatCreateTableWithReservedNestedFieldName(t *testing.T) {
+	client := newCompatClient(t)
+	schema := bigquery.Schema{
+		{Name: "_kafka", Type: bigquery.RecordFieldType, Schema: bigquery.Schema{
+			{Name: "partition", Type: bigquery.IntegerFieldType},
+		}},
+	}
+	if err := client.Dataset("ds").Table("events").Create(context.Background(), &bigquery.TableMetadata{Schema: schema}); err != nil {
+		t.Fatal(err)
+	}
+}
