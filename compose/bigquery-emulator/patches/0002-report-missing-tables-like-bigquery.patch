@@ -0,0 +1,32 @@
+package server_test
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"google.golang.org/api/googleapi"
+)
+
+func assertNotFoundMessage(t *testing.T, err error, want string) {
+	t.Helper()
+	var apiErr *googleapi.Error
+	if !errors.As(err, &apiErr) {
+		t.Fatalf("error = %v, want *googleapi.Error", err)
+	}
+	if apiErr.Code != 404 || apiErr.Message != want {
+		t.Errorf("error = %d %q, want 404 %q", apiErr.Code, apiErr.Message, want)
+	}
+}
+
+func TestBigQueryCompatMissingTableMessage(t *testing.T) {
+	client := newCompatClient(t)
+	_, err := client.Dataset("ds").Table("missing").Metadata(context.Background())
+	assertNotFoundMessage(t, err, "Not found: Table test:ds.missing")
+}
+
+func TestBigQueryCompatMissingDatasetMessage(t *testing.T) {
+	client := newCompatClient(t)
+	_, err := client.Dataset("missing").Metadata(context.Background())
+	assertNotFoundMessage(t, err, "Not found: Dataset test:missing")
+}
